# =================================
# Django Core
# =================================
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
XGGAFFER_DATA_DIR=/path/to/data

# =================================
# Database
# =================================
# SQLite (Development)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (Production - uncomment when ready)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# PostgreSQL
DB_NAME=database
DB_USER=username
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

CLUB_RESOURCES_USE_CLOUDINARY=True
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =================================
# Cache & Task Queue
# =================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =================================
# API Keys
# =================================
ANTHROPIC_API_KEY=your-anthropic-key

# =================================
# Football-data Provider
# =================================
FOOTBALL_DATA_ENABLED=True
FOOTBALL_DATA_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_TOKEN=your-football-data-token
FOOTBALL_DATA_TIMEOUT_SECONDS=15
FOOTBALL_DATA_RETRY_COUNT=2

# =================================
# AWS (For Production)
# =================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# =================================
# Frontend CORS
# =================================
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =================================
# Email (Development)
# =================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

RESEND_API_KEY=your-resend-key
DEFAULT_FROM_EMAIL=your-email@example.com

VITE_API_URL=http://localhost:8000/api

GEMINI_API_KEY=your-gemini-key

THE_ODDS_API_KEY=your-odds-api-key
ODDS_API_ENABLED=True
