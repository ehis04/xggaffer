# =============================================================================
# xgGaffer Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file should be gitignored — never commit real credentials.
#
# Your existing Django variables (SECRET_KEY, DATABASE_URL, etc.) should
# also be in .env. The variables below are specific to the ML pipeline.
# =============================================================================

# --- ML Data Directory ---
# Absolute path to the data/ folder containing raw CSVs, processed
# features, and saved model artifacts.
#
# If not set, the ML pipeline falls back to <project_root>/data/
# which works for local development.
#
# Set this explicitly in production or if your data lives outside
# the project directory (e.g. an S3 mount or shared volume).
XGGAFFER_DATA_DIR=/path/to/your/project/data

# --- Football-data provider (livefootball sync) ---
FOOTBALL_DATA_ENABLED=True
FOOTBALL_DATA_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_TOKEN=your_football_data_api_token_here
FOOTBALL_DATA_TIMEOUT_SECONDS=15
FOOTBALL_DATA_RETRY_COUNT=2
