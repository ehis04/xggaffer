# Copy this file to .env.staging and replace every placeholder.
SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-url-safe-password
DOMAIN=xggaffer.site
WWW_DOMAIN=www.xggaffer.site

ALLOWED_HOSTS=xggaffer.site,www.xggaffer.site
CSRF_TRUSTED_ORIGINS=https://xggaffer.site,https://www.xggaffer.site
CORS_ALLOWED_ORIGINS=https://xggaffer.site,https://www.xggaffer.site
FRONTEND_URL=https://xggaffer.site

# Absolute path to the prediction data directory on the host.
DATA_HOST_PATH=/srv/xggaffer-data

# Optional services
CLUB_RESOURCES_USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FOOTBALL_DATA_API_TOKEN=
THE_ODDS_API_KEY=
ODDS_API_ENABLED=False
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=xgGaffer <noreply@xggaffer.site>
